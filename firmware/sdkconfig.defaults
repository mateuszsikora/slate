# Slate firmware — build configuration.
#
# The board half is taken from the configuration S-3 verified by booting it and
# S-2 measured against (docs/spikes/s3.md appendix, docs/spikes/s2.md), so the
# firmware runs the same silicon settings the spikes reported numbers for.
#
# Every other option belongs to the issue that turns it on, because each comes
# with a measurement that should be taken in the same change that enables it:
# rollback arrived with #12 and core dump with #14, and display and LVGL are
# still #6's to add.

CONFIG_IDF_TARGET="esp32s3"

# --- Flash and PSRAM ---
# ESP32-S3-WROOM-1-N16R8, as read out of the silicon in #3 rather than as the
# vendor documentation describes it (§6.3).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# SPIRAM_FETCH_INSTRUCTIONS and SPIRAM_RODATA stay off. S-3 enabled them to
# measure flash and S-2 disabled them to measure frame time, noting that they
# put code and constants on the same bus the framebuffer is scanned out over.
# That is a display decision on display evidence, so it is #6's to make.

# --- Partition table ---
# Settled in #5 against S-3, documented in §6.3. NVS and LittleFS sit outside
# the two application slots, which is the whole reason this issue can promise
# that an OTA does not take the configuration and the tokens with it.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Development OTA rollback (design.md §11.2) ---
# A freshly uploaded image gets one boot in PENDING_VERIFY. slate_ota confirms
# it only after GET /api/v1/info answers on a real station or setup-AP address;
# any reset before then makes the bootloader return to the previous slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Core dump (design.md §11.3) ---
# A panic writes an ELF core dump into the `coredump` partition #5 reserved, and
# GET /api/v1/coredump serves it. The ELF format rather than the binary one
# because it is what esp-coredump symbolicates a backtrace from; the binary
# format is a task-and-stack blob with no notes in it.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Two knobs are deliberately left at their ESP-IDF defaults, because both
# defaults are the right answer here and the reason is not obvious from the name:
#
#   ESP_COREDUMP_CAPTURE_DRAM (n) adds the whole of .bss, .data and the heap to
#   the dump. Espressif asks for at least 128 KB of coredump partition for that
#   — which is the entire partition (§6.3), sized against a dump of task stacks.
#   A dump that does not fit is §6.3's "worse than no partition at all".
#
#   ESP_COREDUMP_CHECKSUM_CRC32 (the default) over SHA256: the checksum protects
#   a development artifact travelling over a LAN, and SHA256 needs more of the
#   dump stack below to compute — stack that is spent inside a panic handler.
#
# One default is worth stating because it costs DRAM without being asked for:
# with SPIRAM=y, FREERTOS_TASK_CREATE_ALLOW_EXT_MEM defaults to y, which makes
# ESP_COREDUMP_USE_STACK_SIZE=y and reserves ESP_COREDUMP_STACK_SIZE (1792 B) of
# DRAM for a dump stack of its own. That is not optional: a task whose stack is
# in PSRAM cannot be dumped from that stack, and §6.2's internal-memory budget
# has to carry the 1792 B.

# --- Tasks ---
# app_main brings the store up and will bring the display, WiFi and the HTTP
# server up as those land. The default 3584 B is not enough headroom for that.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# CONFIG_FREERTOS_HZ is deliberately left alone. The argument for raising it is
# that LVGL's timer and the §6.2 VSYNC gate resolve in single-digit
# milliseconds, which the default 100 Hz quantises — and that is a display
# argument, on display evidence, so it belongs to #6 along with the measurement
# that justifies it. It is not inherited from the spikes: neither S-2 nor S-3
# records a tick rate.

# --- Clock (§6.1) ---
# The router's own NTP server arrives with the DHCP lease and is preferred over
# the compiled-in pool, which is what makes the clock work on a LAN with no
# route to the internet — the topology of §2 needs nothing else from outside.
# Two server slots because the DHCP one takes slot 0 and the fallback moves to
# slot 1; see slate_time.c, which spells the same arrangement in code.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# --- LittleFS geometry ---
# Pinned rather than left at the component's defaults, because these values
# are the on-disk format. littlefs stores the name length in the superblock and
# validates it at mount, and the read/write/page sizes decide the layout — so a
# component upgrade that shifts a default turns a mount into a reformat, which
# with format_if_mount_failed is a configuration erased on the first boot after
# an OTA. Written here so the values live in the repository rather than only in
# the gitignored sdkconfig.
CONFIG_LITTLEFS_PAGE_SIZE=256
CONFIG_LITTLEFS_OBJ_NAME_LEN=64
CONFIG_LITTLEFS_READ_SIZE=128
CONFIG_LITTLEFS_WRITE_SIZE=128
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_LITTLEFS_CACHE_SIZE=512
CONFIG_LITTLEFS_BLOCK_CYCLES=512
